# ==============================================================================
# WordPress .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SENSITIVE CREDENTIALS & LOCAL CONFIGURATION
# ------------------------------------------------------------------------------
# wp-config.php contains your database password, secret keys, and salts.
# Never commit this file to a public or shared repository!
wp-config.php
wp-config-local.php

# Environment variables (API keys, secrets)
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
# Ignore node_modules in the root or inside any theme/plugin folder.
# Anyone cloning the repo should install dependencies via: npm install
node_modules/

# PHP Composer dependencies (if you use Composer)
/vendor/

# Package manager log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. BUILD ARTIFACTS & CACHES
# ------------------------------------------------------------------------------
# Source maps generated by npm run build / start (huge files not needed in git)
*.map

# Build tool caches
.parcel-cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 4. WORDPRESS DYNAMIC FILES & LOGS
# ------------------------------------------------------------------------------
# Debug and error logs (often contain sensitive server information and errors)
*.log
debug.log
error_log
wp-content/debug.log

# Caching files and plugins drop-ins
wp-content/cache/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/wp-cache-config.php

# WordPress automatic update temporary folder
wp-content/upgrade/

# User-uploaded media (images, PDFs, videos uploaded via WordPress Admin).
# Note: Existing uploaded files already committed to Git stay tracked,
# but new uploads won't clutter your git status.
wp-content/uploads/

# ------------------------------------------------------------------------------
# 5. BACKUPS & DATABASE DUMPS
# ------------------------------------------------------------------------------
# Raw SQL dumps or SQLite database copies
*.sql
*.sql.gz
*.sqlite

# Backup archives created by WordPress plugins or manual exports
*.tar
*.tar.gz
*.zip
wp-content/backups/
wp-content/backup-db/

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows Explorer thumbnails and folder settings
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux temporary and backup files
*~

# ------------------------------------------------------------------------------
# 7. CODE EDITORS & IDEs
# ------------------------------------------------------------------------------
# Visual Studio Code settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains IDEs (PhpStorm, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim swap files
*.swp
*.swo
